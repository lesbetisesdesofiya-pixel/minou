# ─── .env PRODUCTION — un par site (Avedji / Legbassito / Avepozo) ──────────
# Copier vers ".env" dans CHAQUE dossier (/opt/avedji, /opt/legbassito, /opt/avepozo)
# puis ajuster : SITE, APP_PORT, APP_URL, DB_*, JWT_SECRET, API_KEY, MoneyFusion.
#   cp .env.docker.example .env && nano .env
# Sites : avepozo (port 8080), avedji (8081), legbassito (8082).
SITE=avepozo
APP_PORT=8080
APP_NAME="Opera Resto"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://avepozo.operatogo.net

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=opera_resto
DB_USERNAME=root
DB_PASSWORD=change-moi-mot-de-passe-solide

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@operatogo.net"
MAIL_FROM_NAME="${APP_NAME}"

# ─── MoneyFusion ──────────────────────────────────────────────────────────────
MONEYFUSION_API_URL=
MONEYFUSION_STATUS_URL=https://pay.moneyfusion.net/paiementNotif
MONEYFUSION_FEE_RATE=0.10
MONEYFUSION_PAYIN_RATE=0.03
MONEYFUSION_WITHDRAWAL_RATE=0.035
DELIVERY_FEE_DEFAULT=1000
# Paiement désactivé (temporaire) : commandes directes en "Payée", sans MoneyFusion.
# Réactiver : PAYMENT_DISABLED=false (+ rebuild, config cachée au démarrage)
PAYMENT_DISABLED=true

# ─── Clé API (header X-API-Key exigé sur les endpoints publics : /api/menu,
# /api/orders, /api/docs...). À reporter TEL QUEL dans le .env du VPS.
# Apps : myopera/.env.local (EXPO_PUBLIC_API_KEY) et alert/local.properties (apiKey).
API_KEY=change-moi-64-caracteres-hexa-minimum-en-production

# ─── API JWT (générer : php -r "echo bin2hex(random_bytes(32));") ─────────────
JWT_SECRET=change-moi-64-caracteres-hexa-minimum-en-production
